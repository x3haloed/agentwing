diff --git a/Sources/SwiftletCore/SwiftletSession.swift b/Sources/SwiftletCore/SwiftletSession.swift
index 8db2b00..a1df310 100644
--- a/Sources/SwiftletCore/SwiftletSession.swift
+++ b/Sources/SwiftletCore/SwiftletSession.swift
@@ -50,6 +50,9 @@ public final class SwiftletSession: @unchecked Sendable {
         /// prefixes are held across token boundaries, so split stop strings do
         /// not leak into a streamed response.
         public var stopSequences: [String] = []
+        /// End at a complete emitted suffix, retaining its token and live
+        /// state. Unlike stripped stops, these match only at token boundaries.
+        public var stopAfterSequences: [String] = []
         public init() {}
         public static var greedy: GenerationOptions {
             var o = GenerationOptions()
@@ -641,6 +644,15 @@ public final class SwiftletSession: @unchecked Sendable {
                                 shouldCancel: { control.isCancelled }
                             )
                             decodeSeconds += -t0.timeIntervalSinceNow
+                            // Consume the closing token before stopping so the
+                            // emitted prefix and reusable model state agree.
+                            if !options.stopAfterSequences.isEmpty {
+                                let emitted = stopFilter.output.trimmingCharacters(in: .whitespacesAndNewlines)
+                                if options.stopAfterSequences.contains(where: { !$0.isEmpty && emitted.hasSuffix($0) }) {
+                                    finishReason = .stop
+                                    break
+                                }
+                            }
                         }
                     } catch GenerationInterruption.cancelled {
                         finishReason = .cancelled
