diff --git a/Sources/SwiftletServer/ToolProtocol.swift b/Sources/SwiftletServer/ToolProtocol.swift
new file mode 100644
index 0000000..f11d3f8
--- /dev/null
+++ b/Sources/SwiftletServer/ToolProtocol.swift
@@ -0,0 +1,229 @@
+import Foundation
+import SwiftletCore
+
+enum ToolProtocolError: LocalizedError, Equatable {
+    case nonObjectTool
+    case invalidToolDefinition
+    case invalidToolCall(callID: String)
+    case duplicateToolCall(callID: String)
+    case malformedArguments(callID: String)
+    case orphanedToolResult(callID: String)
+    case malformedModelOutput(String)
+    case unknownTool(String)
+
+    var errorDescription: String? {
+        switch self {
+        case .nonObjectTool:
+            return "tool definitions must be JSON objects"
+        case .invalidToolDefinition:
+            return "only named function tool definitions are supported"
+        case .invalidToolCall(let callID):
+            return "tool call \(callID) is not a named function call"
+        case .duplicateToolCall(let callID):
+            return "duplicate tool call ID \(callID)"
+        case .malformedArguments(let callID):
+            return "tool call \(callID) has non-object JSON arguments"
+        case .orphanedToolResult(let callID):
+            return "tool result references unknown call ID \(callID)"
+        case .malformedModelOutput(let detail):
+            return "malformed model tool output: \(detail)"
+        case .unknownTool(let name):
+            return "model called undeclared tool \(name)"
+        }
+    }
+}
+
+/// Codable JSON which can be handed to swift-transformers' heterogeneous
+/// Jinja context without erasing nested schema fields.
+enum JSONValue: Decodable, Sendable {
+    case null
+    case bool(Bool)
+    case int(Int)
+    case double(Double)
+    case string(String)
+    case array([JSONValue])
+    case object([String: JSONValue])
+
+    init(from decoder: Decoder) throws {
+        let value = try decoder.singleValueContainer()
+        if value.decodeNil() { self = .null }
+        else if let decoded = try? value.decode(Bool.self) { self = .bool(decoded) }
+        else if let decoded = try? value.decode(Int.self) { self = .int(decoded) }
+        else if let decoded = try? value.decode(Double.self) { self = .double(decoded) }
+        else if let decoded = try? value.decode(String.self) { self = .string(decoded) }
+        else if let decoded = try? value.decode([JSONValue].self) { self = .array(decoded) }
+        else { self = .object(try value.decode([String: JSONValue].self)) }
+    }
+
+    var templateValue: any Sendable {
+        switch self {
+        case .null: return NSNull()
+        case .bool(let value): return value
+        case .int(let value): return value
+        case .double(let value): return value
+        case .string(let value): return value
+        case .array(let values): return values.map(\.templateValue)
+        case .object(let values): return values.mapValues(\.templateValue)
+        }
+    }
+
+    static func decodeFragment(_ text: String) -> JSONValue? {
+        try? JSONDecoder().decode(JSONValue.self, from: Data(text.utf8))
+    }
+}
+
+struct OpenAIToolDefinition: Decodable, Sendable {
+    let value: JSONValue
+
+    init(from decoder: Decoder) throws {
+        value = try JSONValue(from: decoder)
+    }
+
+    func templateSpec() throws -> SwiftletToolSpec {
+        guard case .object(let object) = value else { throw ToolProtocolError.nonObjectTool }
+        guard case .string("function")? = object["type"], functionName != nil else {
+            throw ToolProtocolError.invalidToolDefinition
+        }
+        return object.mapValues(\.templateValue)
+    }
+
+    var functionName: String? {
+        guard case .object(let tool) = value,
+              case .object(let function)? = tool["function"],
+              case .string(let name)? = function["name"]
+        else { return nil }
+        return name
+    }
+}
+
+struct OpenAIToolCall: Decodable, Sendable {
+    struct Function: Decodable, Sendable {
+        let name: String
+        let arguments: String
+    }
+
+    let id: String
+    let type: String
+    let function: Function
+
+    func templateCall() throws -> [String: any Sendable] {
+        guard type == "function", !function.name.isEmpty else {
+            throw ToolProtocolError.invalidToolCall(callID: id)
+        }
+        guard let decoded = JSONValue.decodeFragment(function.arguments),
+              case .object = decoded
+        else { throw ToolProtocolError.malformedArguments(callID: id) }
+        return [
+            "id": id,
+            "type": type,
+            "function": [
+                "name": function.name,
+                "arguments": decoded.templateValue,
+            ] as [String: any Sendable],
+        ]
+    }
+}
+
+struct ParsedToolCall: Equatable, Sendable {
+    let id: String
+    let name: String
+    let arguments: String
+
+    var wireValue: [String: Any] {
+        [
+            "id": id,
+            "type": "function",
+            "function": ["name": name, "arguments": arguments],
+        ]
+    }
+}
+
+struct ParsedToolReply: Equatable, Sendable {
+    let content: String?
+    let calls: [ParsedToolCall]
+}
+
+/// Strict parser for Qwen3.6's native XML tool syntax. It accepts optional
+/// reasoning before the first call, but rejects unknown tools, duplicate
+/// parameters, malformed nesting, and any suffix after the final call.
+func parseToolReply(_ text: String, declaredTools: Set<String>) throws -> ParsedToolReply? {
+    let reservedMarkers = ["<tool_call>", "</tool_call>", "<function=", "<parameter="]
+    guard reservedMarkers.contains(where: text.contains) else { return nil }
+    guard text.contains("<tool_call>") else {
+        throw ToolProtocolError.malformedModelOutput("reserved tool markup without an opening block")
+    }
+
+    let callPattern = #"(?s)<tool_call>\s*<function=([^>\r\n]+)>\s*(.*?)</function>\s*</tool_call>"#
+    let parameterPattern = #"(?s)<parameter=([^>\r\n]+)>\s*(.*?)\s*</parameter>"#
+    let callRegex = try NSRegularExpression(pattern: callPattern)
+    let parameterRegex = try NSRegularExpression(pattern: parameterPattern)
+    let source = text as NSString
+    let matches = callRegex.matches(in: text, range: NSRange(location: 0, length: source.length))
+    guard !matches.isEmpty else {
+        throw ToolProtocolError.malformedModelOutput("no complete tool_call block")
+    }
+
+    let prefixRange = NSRange(location: 0, length: matches[0].range.location)
+    let prefix = source.substring(with: prefixRange).trimmingCharacters(in: .whitespacesAndNewlines)
+    var previousEnd = matches[0].range.location
+    var calls: [ParsedToolCall] = []
+
+    for match in matches {
+        let gap = NSRange(location: previousEnd, length: match.range.location - previousEnd)
+        guard source.substring(with: gap).trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
+            throw ToolProtocolError.malformedModelOutput("text appeared between tool calls")
+        }
+        previousEnd = NSMaxRange(match.range)
+
+        let name = source.substring(with: match.range(at: 1))
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+        guard declaredTools.contains(name) else { throw ToolProtocolError.unknownTool(name) }
+        let body = source.substring(with: match.range(at: 2))
+        let bodyNSString = body as NSString
+        let parameterMatches = parameterRegex.matches(
+            in: body, range: NSRange(location: 0, length: bodyNSString.length))
+        var parameters: [String: Any] = [:]
+        var parameterEnd = 0
+        for parameter in parameterMatches {
+            let gap = NSRange(
+                location: parameterEnd,
+                length: parameter.range.location - parameterEnd)
+            guard bodyNSString.substring(with: gap)
+                .trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
+                throw ToolProtocolError.malformedModelOutput("invalid parameter markup")
+            }
+            parameterEnd = NSMaxRange(parameter.range)
+            let key = bodyNSString.substring(with: parameter.range(at: 1))
+                .trimmingCharacters(in: .whitespacesAndNewlines)
+            guard !key.isEmpty, parameters[key] == nil else {
+                throw ToolProtocolError.malformedModelOutput("empty or duplicate parameter")
+            }
+            let raw = bodyNSString.substring(with: parameter.range(at: 2))
+                .trimmingCharacters(in: .whitespacesAndNewlines)
+            if let data = raw.data(using: .utf8),
+               let json = try? JSONSerialization.jsonObject(with: data, options: .fragmentsAllowed) {
+                parameters[key] = json
+            } else {
+                parameters[key] = raw
+            }
+        }
+        let tail = NSRange(location: parameterEnd, length: bodyNSString.length - parameterEnd)
+        guard bodyNSString.substring(with: tail)
+            .trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
+            throw ToolProtocolError.malformedModelOutput("unclosed parameter markup")
+        }
+        let arguments = try JSONSerialization.data(
+            withJSONObject: parameters, options: [.sortedKeys])
+        calls.append(ParsedToolCall(
+            id: "call_\(UUID().uuidString.lowercased())",
+            name: name,
+            arguments: String(decoding: arguments, as: UTF8.self)
+        ))
+    }
+
+    let suffixRange = NSRange(location: previousEnd, length: source.length - previousEnd)
+    guard source.substring(with: suffixRange).trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
+        throw ToolProtocolError.malformedModelOutput("text appeared after final tool call")
+    }
+    return ParsedToolReply(content: prefix.isEmpty ? nil : prefix, calls: calls)
+}
