diff --git a/Sources/SwiftletServer/ToolProtocol.swift b/Sources/SwiftletServer/ToolProtocol.swift
index ae467f2..cdd7b5f 100644
--- a/Sources/SwiftletServer/ToolProtocol.swift
+++ b/Sources/SwiftletServer/ToolProtocol.swift
@@ -153,6 +153,57 @@ struct ParsedToolReply: Equatable, Sendable {
     let normalizedSchemaTags: Bool
 }
 
+private struct ToolCallSignature: Equatable, Sendable {
+    let id: String
+    let type: String
+    let name: String
+    let arguments: String
+}
+
+private func canonicalArguments(_ text: String) -> String? {
+    guard let value = JSONValue.decodeFragment(text), case .object = value,
+          let data = try? JSONSerialization.data(
+            withJSONObject: value.templateValue, options: [.sortedKeys])
+    else { return nil }
+    return String(decoding: data, as: UTF8.self)
+}
+
+/// Remembers the most recently accepted native spelling of a tool call. When
+/// the client echoes the same structured OpenAI calls, rendering that spelling
+/// makes the next prompt an exact extension of the model's live token state.
+/// IDs, names, types, and canonical arguments must all match; otherwise the
+/// ordinary structured template path is used and the session resets safely.
+final class ToolReplayCache: @unchecked Sendable {
+    private let lock = NSLock()
+    private var signatures: [ToolCallSignature] = []
+    private var rawText: String?
+
+    func record(reply: ParsedToolReply, rawText: String) {
+        let next = reply.calls.map {
+            ToolCallSignature(
+                id: $0.id, type: "function", name: $0.name,
+                arguments: canonicalArguments($0.arguments) ?? $0.arguments)
+        }
+        lock.lock()
+        signatures = next
+        self.rawText = rawText
+        lock.unlock()
+    }
+
+    func replayText(for calls: [OpenAIToolCall]) -> String? {
+        let incoming: [ToolCallSignature] = calls.compactMap { call in
+            guard let arguments = canonicalArguments(call.function.arguments) else { return nil }
+            return ToolCallSignature(
+                id: call.id, type: call.type, name: call.function.name,
+                arguments: arguments)
+        }
+        guard incoming.count == calls.count else { return nil }
+        lock.lock()
+        defer { lock.unlock() }
+        return incoming == signatures ? rawText : nil
+    }
+}
+
 /// Strict parser for Qwen3.6's native XML tool syntax. It accepts optional
 /// reasoning before the first call, but rejects unknown tools, duplicate
 /// parameters, malformed nesting, and any suffix after the final call.
