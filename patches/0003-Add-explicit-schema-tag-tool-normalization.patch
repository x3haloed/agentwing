From b33871230f51d3e3ec497eb2e6724fbf9557bb9d Mon Sep 17 00:00:00 2001
From: Chad Kirby <x3haloed@gmail.com>
Date: Thu, 3 Sep 2026 20:42:32 -0700
Subject: [PATCH] Add explicit schema-tag tool normalization

---
 README.md                                     |  4 +-
 Sources/SwiftletServer/ToolProtocol.swift     | 67 ++++++++++++++++---
 Sources/SwiftletServer/main.swift             | 29 ++++++--
 .../ChatRequestTests.swift                    | 28 +++++++-
 4 files changed, 112 insertions(+), 16 deletions(-)

diff --git a/README.md b/README.md
index 024fd1a..c9f1a6b 100644
--- a/README.md
+++ b/README.md
@@ -160,7 +160,9 @@ Swiftlet is a library first:
    tool output is validated before it is returned as `tool_calls`. Tool-bearing
    generations are buffered and currently prefill their complete history so a
    partial XML call can never leak and cache reuse cannot cross an unrepresented
-   tool boundary.
+   tool boundary. `--accept-schema-tags` explicitly accepts `<path>…</path>`-style
+   argument tags only when `path` is declared by that function's JSON schema;
+   every such normalization is logged. Strict native syntax remains the default.
 4. **An app.** [Priv AI](https://apps.apple.com/us/app/priv-ai/id6765706001)
    on iOS embeds SwiftletCore as its streamed-model engine. End users tap
    Download and chat. Nothing here is terminal-only. The app itself is open
diff --git a/Sources/SwiftletServer/ToolProtocol.swift b/Sources/SwiftletServer/ToolProtocol.swift
index f11d3f8..ae467f2 100644
--- a/Sources/SwiftletServer/ToolProtocol.swift
+++ b/Sources/SwiftletServer/ToolProtocol.swift
@@ -94,6 +94,15 @@ struct OpenAIToolDefinition: Decodable, Sendable {
         else { return nil }
         return name
     }
+
+    var parameterNames: Set<String> {
+        guard case .object(let tool) = value,
+              case .object(let function)? = tool["function"],
+              case .object(let parameters)? = function["parameters"],
+              case .object(let properties)? = parameters["properties"]
+        else { return [] }
+        return Set(properties.keys)
+    }
 }
 
 struct OpenAIToolCall: Decodable, Sendable {
@@ -141,12 +150,17 @@ struct ParsedToolCall: Equatable, Sendable {
 struct ParsedToolReply: Equatable, Sendable {
     let content: String?
     let calls: [ParsedToolCall]
+    let normalizedSchemaTags: Bool
 }
 
 /// Strict parser for Qwen3.6's native XML tool syntax. It accepts optional
 /// reasoning before the first call, but rejects unknown tools, duplicate
 /// parameters, malformed nesting, and any suffix after the final call.
-func parseToolReply(_ text: String, declaredTools: Set<String>) throws -> ParsedToolReply? {
+func parseToolReply(
+    _ text: String,
+    declaredTools: Set<String>,
+    acceptedSchemaTags: [String: Set<String>] = [:]
+) throws -> ParsedToolReply? {
     let reservedMarkers = ["<tool_call>", "</tool_call>", "<function=", "<parameter="]
     guard reservedMarkers.contains(where: text.contains) else { return nil }
     guard text.contains("<tool_call>") else {
@@ -167,6 +181,7 @@ func parseToolReply(_ text: String, declaredTools: Set<String>) throws -> Parsed
     let prefix = source.substring(with: prefixRange).trimmingCharacters(in: .whitespacesAndNewlines)
     var previousEnd = matches[0].range.location
     var calls: [ParsedToolCall] = []
+    var normalizedSchemaTags = false
 
     for match in matches {
         let gap = NSRange(location: previousEnd, length: match.range.location - previousEnd)
@@ -180,11 +195,45 @@ func parseToolReply(_ text: String, declaredTools: Set<String>) throws -> Parsed
         guard declaredTools.contains(name) else { throw ToolProtocolError.unknownTool(name) }
         let body = source.substring(with: match.range(at: 2))
         let bodyNSString = body as NSString
-        let parameterMatches = parameterRegex.matches(
-            in: body, range: NSRange(location: 0, length: bodyNSString.length))
+        struct ParameterMatch {
+            let range: NSRange
+            let key: String
+            let value: String
+            let normalized: Bool
+        }
+        var parameterMatches = parameterRegex.matches(
+            in: body, range: NSRange(location: 0, length: bodyNSString.length)
+        ).map { parameter in
+            ParameterMatch(
+                range: parameter.range,
+                key: bodyNSString.substring(with: parameter.range(at: 1))
+                    .trimmingCharacters(in: .whitespacesAndNewlines),
+                value: bodyNSString.substring(with: parameter.range(at: 2))
+                    .trimmingCharacters(in: .whitespacesAndNewlines),
+                normalized: false)
+        }
+        for parameterName in acceptedSchemaTags[name] ?? [] {
+            let escaped = NSRegularExpression.escapedPattern(for: parameterName)
+            let alternate = try NSRegularExpression(
+                pattern: "(?s)<\(escaped)>\\s*(.*?)\\s*</\(escaped)>")
+            parameterMatches += alternate.matches(
+                in: body, range: NSRange(location: 0, length: bodyNSString.length)
+            ).map { parameter in
+                ParameterMatch(
+                    range: parameter.range,
+                    key: parameterName,
+                    value: bodyNSString.substring(with: parameter.range(at: 1))
+                        .trimmingCharacters(in: .whitespacesAndNewlines),
+                    normalized: true)
+            }
+        }
+        parameterMatches.sort { $0.range.location < $1.range.location }
         var parameters: [String: Any] = [:]
         var parameterEnd = 0
         for parameter in parameterMatches {
+            guard parameter.range.location >= parameterEnd else {
+                throw ToolProtocolError.malformedModelOutput("overlapping parameter markup")
+            }
             let gap = NSRange(
                 location: parameterEnd,
                 length: parameter.range.location - parameterEnd)
@@ -193,13 +242,12 @@ func parseToolReply(_ text: String, declaredTools: Set<String>) throws -> Parsed
                 throw ToolProtocolError.malformedModelOutput("invalid parameter markup")
             }
             parameterEnd = NSMaxRange(parameter.range)
-            let key = bodyNSString.substring(with: parameter.range(at: 1))
-                .trimmingCharacters(in: .whitespacesAndNewlines)
+            let key = parameter.key
             guard !key.isEmpty, parameters[key] == nil else {
                 throw ToolProtocolError.malformedModelOutput("empty or duplicate parameter")
             }
-            let raw = bodyNSString.substring(with: parameter.range(at: 2))
-                .trimmingCharacters(in: .whitespacesAndNewlines)
+            let raw = parameter.value
+            normalizedSchemaTags = normalizedSchemaTags || parameter.normalized
             if let data = raw.data(using: .utf8),
                let json = try? JSONSerialization.jsonObject(with: data, options: .fragmentsAllowed) {
                 parameters[key] = json
@@ -225,5 +273,8 @@ func parseToolReply(_ text: String, declaredTools: Set<String>) throws -> Parsed
     guard source.substring(with: suffixRange).trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
         throw ToolProtocolError.malformedModelOutput("text appeared after final tool call")
     }
-    return ParsedToolReply(content: prefix.isEmpty ? nil : prefix, calls: calls)
+    return ParsedToolReply(
+        content: prefix.isEmpty ? nil : prefix,
+        calls: calls,
+        normalizedSchemaTags: normalizedSchemaTags)
 }
