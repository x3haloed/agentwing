+    if streaming {
+        var delta: [String: Any] = ["role": "assistant", "tool_calls": calls]
+        if let content = reply.content { delta["content"] = content }
+        choice["delta"] = delta
+        choice["finish_reason"] = finish ?? NSNull()
+    } else {
+        choice["message"] = [
+            "role": "assistant",
+            "content": reply.content ?? NSNull(),
