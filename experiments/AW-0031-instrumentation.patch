diff --git a/Sources/SwiftletCore/ExpertIOTrace.swift b/Sources/SwiftletCore/ExpertIOTrace.swift
new file mode 100644
index 0000000..93108d9
--- /dev/null
+++ b/Sources/SwiftletCore/ExpertIOTrace.swift
@@ -0,0 +1,29 @@
+import Foundation
+
+/// AW-0031 diagnostic only. Bounded, opt-in; never used by P1.
+final class ExpertIOTrace: @unchecked Sendable {
+    static let shared: ExpertIOTrace? = {
+        guard let path = ProcessInfo.processInfo.environment["SWIFTLET_EXPERT_TRACE"] else { return nil }
+        return ExpertIOTrace(path: path)
+    }()
+    private let handle: FileHandle
+    private let lock = NSLock()
+    private var count = 0
+    private init?(path: String) {
+        guard !FileManager.default.fileExists(atPath: path),
+              FileManager.default.createFile(atPath: path, contents: nil),
+              let file = FileHandle(forWritingAtPath: path) else { return nil }
+        handle = file
+    }
+    func emit(_ fields: [String: Any]) {
+        lock.lock(); defer { lock.unlock() }
+        guard count < 10000 else { return }
+        var row = fields; row["sequence"] = count
+        row["uptime"] = ProcessInfo.processInfo.systemUptime
+        count += 1
+        if let data = try? JSONSerialization.data(withJSONObject: row, options: [.sortedKeys]) {
+            handle.write(data); handle.write(Data([10]))
+        }
+    }
+    deinit { try? handle.close() }
+}
diff --git a/Sources/SwiftletCore/QwenMetalModel.swift b/Sources/SwiftletCore/QwenMetalModel.swift
