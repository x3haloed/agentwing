         var converted: [SwiftletChatMessage] = []
@@ -119,7 +120,13 @@ struct ChatRequest: Decodable {
             }
         }
         let specs = definitions.isEmpty ? nil : try definitions.map { try $0.templateSpec() }
-        return (converted, specs, names)
+        var parameters: [String: Set<String>] = [:]
+        for definition in definitions {
+            guard let name = definition.functionName,
+                  parameters.updateValue(definition.parameterNames, forKey: name) == nil
+            else { throw ToolProtocolError.invalidToolDefinition }
+        }
+        return (converted, specs, names, parameters)
     }
 }
 
@@ -129,12 +136,13 @@ func flag(_ name: String) -> String? {
     return cliArgs[i + 1]
 }
 guard let modelPath = flag("--model") else {
-    print("usage: swiftlet-server --model <dir> [--port 8080] [--cache-gb 2] [--debug-tool-output]")
+    print("usage: swiftlet-server --model <dir> [--port 8080] [--cache-gb 2] [--debug-tool-output] [--accept-schema-tags]")
     exit(2)
 }
 let port = Int(flag("--port") ?? "8080") ?? 8080
 let cacheGB = Double(flag("--cache-gb") ?? "2") ?? 2
 let debugToolOutput = cliArgs.contains("--debug-tool-output")
+let acceptSchemaTags = cliArgs.contains("--accept-schema-tags")
 let modelURL = URL(fileURLWithPath: modelPath)
 
 FileHandle.standardError.write(Data("loading model + tokenizer...\n".utf8))
@@ -386,7 +394,8 @@ final class HTTPHandler: ChannelInboundHandler {
         let templateInput: (
             messages: [SwiftletChatMessage],
             tools: [SwiftletToolSpec]?,
-            toolNames: Set<String>
+            toolNames: Set<String>,
+            toolParameters: [String: Set<String>]
         )
         do {
             templateInput = try request.templateInput()
@@ -399,6 +408,7 @@ final class HTTPHandler: ChannelInboundHandler {
         let messages = templateInput.messages
         let tools = templateInput.tools
         let toolNames = templateInput.toolNames
+        let toolParameters = templateInput.toolParameters
         let maxNew = request.max_tokens ?? request.max_completion_tokens ?? 512
         let streaming = request.stream ?? false
         let id = "chatcmpl-\(UUID().uuidString.prefix(8))"
@@ -511,7 +521,14 @@ final class HTTPHandler: ChannelInboundHandler {
                     ).utf8))
                     let toolReply: ParsedToolReply?
                     do {
-                        toolReply = try parseToolReply(fullText, declaredTools: toolNames)
+                        toolReply = try parseToolReply(
+                            fullText,
+                            declaredTools: toolNames,
+                            acceptedSchemaTags: acceptSchemaTags ? toolParameters : [:])
+                        if toolReply?.normalizedSchemaTags == true {
+                            FileHandle.standardError.write(Data(
+                                "[\(id)] normalized declared schema-property tags\n".utf8))
