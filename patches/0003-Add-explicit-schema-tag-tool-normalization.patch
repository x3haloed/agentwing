                     } catch {
                         if debugToolOutput {
                             let escaped = String(reflecting: fullText)
diff --git a/Tests/SwiftletServerTests/ChatRequestTests.swift b/Tests/SwiftletServerTests/ChatRequestTests.swift
index 679c054..3abfea9 100644
--- a/Tests/SwiftletServerTests/ChatRequestTests.swift
+++ b/Tests/SwiftletServerTests/ChatRequestTests.swift
@@ -62,6 +62,7 @@ import SwiftletCore
         )
         let input = try r.templateInput()
         #expect(input.toolNames == ["read"])
+        #expect(input.toolParameters["read"] == ["path"])
         #expect(input.tools?.count == 1)
         #expect(input.messages.count == 3)
         #expect(input.messages[2]["tool_call_id"] as? String == "c1")
@@ -150,10 +151,35 @@ import SwiftletCore
         }
     }
 
+    @Test func declaredSchemaTagsRequireExplicitOptIn() throws {
+        let raw = """
+            <tool_call>
+            <function=read>
+            <parameter=limit>20</parameter>
+            <path>TARGET.md</path>
+            </function>
+            </tool_call>
+            """
+        #expect(throws: ToolProtocolError.self) {
+            _ = try parseToolReply(raw, declaredTools: ["read"])
+        }
+        let parsed = try parseToolReply(
+            raw,
+            declaredTools: ["read"],
+            acceptedSchemaTags: ["read": ["path", "limit"]])
+        let reply = try #require(parsed)
+        #expect(reply.normalizedSchemaTags)
+        let arguments = try JSONSerialization.jsonObject(
+            with: Data(reply.calls[0].arguments.utf8)) as? [String: Any]
+        #expect(arguments?["path"] as? String == "TARGET.md")
+        #expect(arguments?["limit"] as? Int == 20)
+    }
+
     @Test func toolCompletionPayloadUsesOpenAIShape() throws {
         let reply = ParsedToolReply(
             content: nil,
-            calls: [ParsedToolCall(id: "c1", name: "read", arguments: #"{"path":"TARGET.md"}"#)])
+            calls: [ParsedToolCall(id: "c1", name: "read", arguments: #"{"path":"TARGET.md"}"#)],
+            normalizedSchemaTags: false)
         let payload = toolCompletionPayload(
             id: "chatcmpl-test", reply: reply, streaming: true,
             model: "swiftlet-test")
