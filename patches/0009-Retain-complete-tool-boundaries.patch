index 0000000..dc1e388
--- /dev/null
+++ b/Tests/SwiftletCoreTests/RetainedStopTests.swift
@@ -0,0 +1,101 @@
+import Foundation
+import Testing
+@testable import SwiftletCore
+
+@Suite struct RetainedStopTests {
+    private final class ScriptModel: InferenceModel, @unchecked Sendable {
+        let config: QwenConfig
+        let modelDir: URL
+        private let lock = NSLock()
+        private var recorded: [(tokens: [Int], state: ObjectIdentifier)] = []
+
+        init() throws {
+            modelDir = URL(fileURLWithPath: #filePath)
+                .deletingLastPathComponent().deletingLastPathComponent()
+                .deletingLastPathComponent().appendingPathComponent("fixtures/tiny-model")
+            config = try QwenConfig(url: modelDir.appendingPathComponent("config.json"))
+        }
+
+        var calls: [(tokens: [Int], state: ObjectIdentifier)] {
+            lock.lock()
+            defer { lock.unlock() }
+            return recorded
+        }
+
+        func step(_ tokens: [Int], state: QwenCPUModel.DecodeState) throws -> [Float] {
+            lock.lock()
+            recorded.append((tokens, ObjectIdentifier(state)))
+            lock.unlock()
+            state.position += tokens.count
+            var logits = [Float](repeating: -100, count: config.vocabSize)
+            logits[64 + state.position] = 100
+            return logits
+        }
+    }
+
+    private func collect(_ stream: AsyncThrowingStream<String, Swift.Error>) async throws -> String {
+        var output = ""
+        for try await delta in stream { output += delta }
+        return output
+    }
+
+    @Test(arguments: [false, true])
+    func retainedDelimiterConsumesClosingTokenAndReusesExactPrefix(mergedWhitespace: Bool) async throws {
+        let model = try ScriptModel()
+        let pieces = mergedWhitespace
+            ? ["<tool_call>", "body", "</tool_call>\n", "UNWANTED"]
+            : ["<tool_call>", "body", "</tool", "_call>", "UNWANTED"]
+        let acceptedIDs = Array(65..<(65 + pieces.count - 1))
+        let expected = pieces.dropLast().joined()
+        let session = SwiftletSession(
+            testingModel: model, modelDir: model.modelDir,
+            encodeText: { _ in [20] },
+            decodeTokens: { ids in ids.map { pieces[$0 - 65] }.joined() },
+            renderMessages: { messages in
+                messages.last?["content"] == "result" ? [10] + acceptedIDs + [20] : [10]
+            }
+        )
+        var options = SwiftletSession.GenerationOptions.greedy
+        options.minNew = 0
+        options.noRepeatNGram = 0
+        options.stopAfterSequences = ["</tool_call>"]
+        let tools: [SwiftletToolSpec] = [["type": "function"]]
+        let output = try await collect(session.streamChat(
+            messages: [["role": "user", "content": "one"]],
+            tools: tools, maxNew: pieces.count, options: options))
+        #expect(output == expected)
+        #expect(session.lastMetrics.finishReason == .stop)
+        #expect(session.lastMetrics.generatedTokens == acceptedIDs.count)
+        #expect(model.calls.map(\.tokens) == [[10]] + acceptedIDs.map { [$0] })
+
+        _ = try await collect(session.streamChat(messages: [
+            ["role": "user", "content": "one"],
+            ["role": "assistant", "content": expected],
+            ["role": "tool", "content": "result"],
+        ], tools: tools, maxNew: 0, options: options))
+        #expect(session.lastMetrics.reusedPromptTokens == acceptedIDs.count + 1)
+        #expect(session.lastMetrics.promptTokens == 1)
+        #expect(model.calls.last?.tokens == [20])
+        #expect(Set(model.calls.map(\.state)).count == 1)
+    }
+
+    @Test(arguments: [false, true])
+    func defaultAndEmptyRetainedStopsDoNotTruncate(emptyEntry: Bool) async throws {
+        let model = try ScriptModel()
+        let pieces = ["hello", "</tool_call>", "tail"]
+        let session = SwiftletSession(
+            testingModel: model, modelDir: model.modelDir,
+            encodeText: { _ in [20] },
+            decodeTokens: { ids in ids.map { pieces[$0 - 65] }.joined() },
+            renderMessages: { _ in [10] }
+        )
+        var options = SwiftletSession.GenerationOptions.greedy
+        options.minNew = 0
+        options.stopAfterSequences = emptyEntry ? [""] : []
+        let output = try await collect(session.streamChat(
+            messages: [["role": "user", "content": "one"]],
+            maxNew: pieces.count, options: options))
+        #expect(output == pieces.joined())
+        #expect(session.lastMetrics.finishReason == .length)
+    }
+}
